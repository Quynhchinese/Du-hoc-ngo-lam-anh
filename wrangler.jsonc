{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Tên Worker trên Cloudflare — phải trùng với tên dự án Cloudflare và với "service" bên dưới
  "name": "du-hoc-ngo-lam-anh",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Worker tự gọi lại chính nó (OpenNext dùng khi làm mới trang) — tên phải trùng "name" ở trên
      "binding": "WORKER_SELF_REFERENCE",
      "service": "du-hoc-ngo-lam-anh"
    }
  ],
  "d1_databases": [
    {
      // Cơ sở dữ liệu dashboard (tài khoản, bài viết, đăng ký học).
      // Tạo bằng: npx wrangler d1 create du-hoc-ngoc-lam-anh  → dán database_id vào đây
      "binding": "DB",
      "database_name": "du-hoc-ngoc-lam-anh",
      "database_id": "347fd7ff-95db-48df-ab4d-22e6158eff86",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Email được tự tạo tài khoản admin ở lần đăng nhập Google đầu tiên (phân cách bằng dấu phẩy)
    "ADMIN_EMAILS": "trungtamquynhchinese@gmail.com",
    // Kho GitHub chứa code web – dashboard ghi nội dung trang vào đây
    "GITHUB_REPO": "Quynhchinese/Du-hoc-ngo-lam-anh",
    "GITHUB_BRANCH": "main"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
